<?xml version="1.0"?>
<!--
    The payment method is a Magento\Payment\Model\Method\Adapter virtual type —
    the supported way to declare a gateway since 2.3. There is no CommandPool:
    Receivify never sees card data and never captures through Magento. The order
    is placed, the customer is redirected to the hosted checkout, and the signed
    webhook is what marks the order paid.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <virtualType name="ReceivifyPaymentsFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Receivify\Payments\Model\Ui\ConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">ReceivifyPaymentsValueHandlerPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="ReceivifyPaymentsValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ReceivifyPaymentsConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ReceivifyPaymentsConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ReceivifyPaymentsGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="ReceivifyPaymentsGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Receivify\Payments\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </virtualType>

</config>
